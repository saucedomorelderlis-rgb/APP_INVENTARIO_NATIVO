        "import subprocess\n",
        "import time\n",
        "import socket\n",
        "import requests\n",
        "\n",
        "# 1. Asegurar que cualquier proceso previo de ollama esté cerrado para evitar conflictos\n",
        "!pkill ollama || true\n",
        "\n",
        "# 2. Iniciar el servidor de Ollama y redirigir logs a un archivo local\n",
        "print(\"Iniciando el servidor de Ollama en segundo plano...\")\n",
        "with open(\"ollama.log\", \"w\") as log_file:\n",
        "    process = subprocess.Popen([\"ollama\", \"serve\"], stdout=log_file, stderr=log_file, close_fds=True)\n",
        "\n",
        "# 3. Esperar y verificar activamente si el servicio está levantado en el puerto 11434\n",
        "for i in range(10):\n",
        "    try:\n",
        "        response = requests.get(\"http://localhost:11434/\")\n",
        "        if response.status_code == 200:\n",
        "            print(\"✓ ¡Ollama está activo y respondiendo correctamente en segundo plano!\")\n",
        "            break\n",
        "    except requests.exceptions.ConnectionError:\n",
        "        pass\n",
        "    time.sleep(2)\n",
        "else:\n",
        "    print(\"⚠ El servidor está tardando en responder. Revisa 'ollama.log' si hay inconvenientes.\")\n"
