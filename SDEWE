        "import subprocess\n",
        "import time\n",
        "\n",
        "# Asegurar que el servidor anterior esté detenido e iniciar uno nuevo\n",
        "print(\"Reiniciando el servidor de Ollama en segundo plano...\")\n",
        "subprocess.run(\"pkill ollama\", shell=True)\n",
        "time.sleep(1)\n",
        "\n",
        "process = subprocess.Popen(\"ollama serve\", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
        "time.sleep(5)\n",
        "print(\"Servidor de Ollama iniciado con éxito.\")"
